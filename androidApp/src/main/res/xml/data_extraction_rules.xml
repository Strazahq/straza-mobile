<?xml version="1.0" encoding="utf-8"?>
<!--
  Opts out of both cloud backup and device-to-device transfer on Android 12+.
  An enrollment is bound to one physical device: the private key is
  hardware-bound and cannot leave it, and these rules keep the enrollment
  record from leaving either. A new phone must be enrolled again.

  android:allowBackup="false" in the manifest covers cloud backup before
  Android 12 and adb backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
