# Release signing template.
#
# Copy this file to `keystore.properties` (git-ignored) and fill in the real
# values, or provide the same four values as environment variables. Do not
# commit the keystore or its passwords.
#
#   keystore.properties key   environment variable
#   storeFile                 STRAZA_RELEASE_STORE_FILE (path to the .jks;
#                             relative paths resolve against the repository root)
#   storePassword             STRAZA_RELEASE_STORE_PASSWORD
#   keyAlias                  STRAZA_RELEASE_KEY_ALIAS
#   keyPassword               STRAZA_RELEASE_KEY_PASSWORD
#
# If any value is missing the release build is left unsigned, so a clean
# checkout still assembles.

storeFile=straza-release.jks
storePassword=CHANGE_ME
keyAlias=straza
keyPassword=CHANGE_ME

# Generate the upload key. It is unrelated to the app's device identity key,
# which is a hardware-bound P-256 key.
#
#   keytool -genkeypair -v -keystore straza-release.jks -alias straza \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Back the key up offline. On Play a lost upload key can be reset through
# Google support, because Play App Signing holds the app signing key. A lost
# key for the F-Droid or GitHub release cannot be replaced, and installed foss
# builds then cannot be updated. The applicationId (ai.straza.approver) cannot
# change after the first store upload.
