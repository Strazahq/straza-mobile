<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Checked in, not generated: XcodeGen's entitlements block would overwrite
     this file with an empty dict. project.yml references it as
     CODE_SIGN_ENTITLEMENTS.

     aps-environment is `production` because TestFlight builds use production
     APNs tokens. A build without the entitlement uploads successfully but
     cannot obtain a device token.

     time-sensitive needs the Time Sensitive Notifications capability on the
     App ID. The export fails without it. -->
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
