<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Read by `xcodebuild -exportArchive` in the TestFlight workflow, which
     uploads the signed build to App Store Connect. Signing is cloud-managed
     through the App Store Connect API key. manageAppVersionAndBuildNumber is
     false so that the version numbers in Info.plist are used unchanged. -->
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>WMPWM57KYK</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
